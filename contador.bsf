	(rect 16 16 136 112)
	(text "contador" (rect 5 0 56 14)(font "Intel Clear" (font_size 8)))
	(text "inst" (rect 8 80 24 92)(font "Intel Clear" ))
	(port
		(pt 0 32)
		(input)
		(text "clock" (rect 0 0 29 14)(font "Intel Clear" (font_size 8)))
		(text "clock" (rect 21 27 50 41)(font "Intel Clear" (font_size 8)))
		(line (pt 0 32)(pt 16 32))
	)
	(port
		(pt 0 48)
		(input)
		(text "reset" (rect 0 0 29 14)(font "Intel Clear" (font_size 8)))
		(text "reset" (rect 21 43 50 57)(font "Intel Clear" (font_size 8)))
		(line (pt 0 48)(pt 16 48))
	)
	(port
		(pt 120 32)
		(output)
		(text "C[5..0]" (rect 0 0 38 14)(font "Intel Clear" (font_size 8)))
		(text "C[5..0]" (rect 61 27 99 41)(font "Intel Clear" (font_size 8)))
		(line (pt 120 32)(pt 104 32)(line_width 3))
	)
